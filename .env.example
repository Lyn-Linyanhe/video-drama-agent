# LLM Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=  # For custom endpoints (e.g., DeepSeek, Kimi, Qwen, etc.)
# Dedicated Kimi review for generated storyboard prompts.
# Configure this separately when the primary LLM is DeepSeek.
KIMI_PROMPT_REVIEW_ENABLED=true
# KIMI_PROMPT_REVIEW_API_KEY=
# KIMI_PROMPT_REVIEW_MODEL=kimi-k2.6
# KIMI_PROMPT_REVIEW_BASE_URL=https://api.moonshot.cn/v1
# KIMI_PROMPT_REVIEW_BATCH_SIZE=4
# Official Moonshot Kimi example:
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k2.6
# OPENAI_API_KEY=your-moonshot-api-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Video API Keys (optional — mock mode works without these)
KLING_API_KEY=
KLING_API_SECRET=
RUNWAY_API_KEY=
PIKA_API_KEY=

# Happy Horse (快马) Video API
HAPPYHORSE_API_KEY=your-api-key-here
HAPPYHORSE_BASE_URL=https://dashscope.aliyuncs.com
HAPPYHORSE_MODEL=happyhorse-1.1-r2v
HAPPYHORSE_RESOLUTION=1080p

# Default video API: "mock", "kling", "runway", "pika", "happyhorse"
DEFAULT_VIDEO_API=mock

# Public access login protection
# Set STUDIO_PASSWORD before exposing this app to the internet.
STUDIO_AUTH_ENABLED=1
STUDIO_USERNAME=admin
STUDIO_PASSWORD=change-this-password
STUDIO_AUTH_SECRET=change-this-random-secret
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=32768
# Maximum screenplay characters accepted by the API/import route.
LLM_MAX_INPUT_CHARS=80000
