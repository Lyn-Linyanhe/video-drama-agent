# LLM Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=  # For custom endpoints (e.g., DeepSeek, Qwen, etc.)

# Video API Keys (optional — mock mode works without these)
KLING_API_KEY=
KLING_API_SECRET=
RUNWAY_API_KEY=
PIKA_API_KEY=

# Default video API: "mock", "kling", "runway", "pika"
DEFAULT_VIDEO_API=mock
